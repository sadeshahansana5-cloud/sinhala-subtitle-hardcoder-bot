# Telegram credentials — set privately in the hosting environment; never commit real values.
# BOT_TOKEN must belong to the exact bot configured in BotFather for this Mini App.
API_ID=1234567
API_HASH=YOUR_API_HASH
BOT_TOKEN=YOUR_BOT_TOKEN

# Public HTTPS origin required; set BotFather Mini App/Menu URL to this origin + /dashboard. Do not append /dashboard here.
PUBLIC_URL=https://your-public-host.example
PORT=7860

# Mini App switch is persistent in webapp_control.json. These commands are restricted
# to comma-separated numeric Telegram user IDs; leave the allowlist empty until set.
WEBAPP_ENABLED=false
WEBAPP_ADMIN_IDS=

# Mini App storage, upload and authentication limits.
DASHBOARD_DB_PATH=./dashboard_history.sqlite3
DASHBOARD_UPLOAD_MAX_GB=1.9
DASHBOARD_SRT_MAX_MB=20
DASHBOARD_AUTH_MAX_AGE_SECONDS=86400

# Output naming: default 300 seconds (5 minutes).
FILE_AUTO_SEND_SECONDS=300

# Public packs searched by this bot at startup and when /stickers is used.
# These are searched by this bot's own BOT_TOKEN so returned file_id values work for this bot.
STICKER_PACK_NAMES=SubAnalyserRobot_by_fStikBot,FunkyGoose
STICKER_MIN_INTERVAL=0.8

# Optional Bot API file_id overrides obtained for THIS bot only. Leave blank for pack lookup.
STICKER_RECEIVED=
STICKER_DOWNLOAD=
STICKER_ENCODING=
STICKER_QUALITY=
STICKER_UPLOAD=
STICKER_EXTRACT=
STICKER_SYNC=
STICKER_SUCCESS=
STICKER_ERROR=
STICKER_MENU=
STICKER_WELCOME=

# Owner-scoped font manager.
# No default font bundle is downloaded at startup; only fonts/ and explicit user uploads are used.
FONT_MAX_UPLOAD_MB=12
FONT_MAX_FILES_PER_USER=20

# Your own stickers: send /stickers to the bot, send many stickers, then /done.
# They are saved in sticker_store.json (keep it on a persistent disk) and a copy is pinned in your chat.
# Optional: only these Telegram user IDs may change stickers (empty = WEBAPP_ADMIN_IDS, or everyone if both empty).
STICKER_ADMIN_IDS=
# Optional: your Telegram user ID, used to restore stickers from the pinned backup if the host wipes its disk.
STICKER_BACKUP_CHAT_ID=

# Sticker speed: a step waits at most this many seconds for its sticker before continuing.
STICKER_WAIT_SECONDS=6
# Bot reacts (⚡ / 👀 / 👍) to every command / video / file you send. 0 = off.
REACT_ON_MESSAGES=1
